# ═══════════════════════════════════════════════════════════════════════════════
# Nexus — Environment Variables
# Copy to .env and fill in values. Required vars are marked with [REQUIRED].
# Generate secrets: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# ═══════════════════════════════════════════════════════════════════════════════

# ── Application ──────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
CLIENT_ORIGIN=http://localhost:3000

# ── Database (PostgreSQL) ────────────────────────────────────────────────────
# [REQUIRED] — matches docker-compose postgres service defaults
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/nest_nexus

# ── Session ──────────────────────────────────────────────────────────────────
# [REQUIRED] — min 32 chars, random hex
SESSION_SECRET=change-me-to-at-least-32-chars-long-session-secret

# ── JWT ──────────────────────────────────────────────────────────────────────
# [REQUIRED] — min 32 chars each, all different
JWT_SECRET=change-me-to-at-least-32-chars-long-jwt-secret
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-to-at-least-32-chars-long-refresh-secret
JWT_REFRESH_EXPIRES_IN=7d

# ── Redis ────────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_PASSWORD=            # Uncomment if Redis requires auth (production)

# ── OAuth2 — Google (Phase 5) ────────────────────────────────────────────────
# Create at: https://console.cloud.google.com/apis/credentials
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# ── OAuth2 — GitHub (Phase 5) ────────────────────────────────────────────────
# Create at: https://github.com/settings/developers
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# ── Email / SMTP (Phase 4) ───────────────────────────────────────────────────
# Used by: magic links, 2FA backup codes, welcome emails (via BullMQ email queue)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false          # true for port 465
# SMTP_USER=you@example.com
# SMTP_PASS=
# SMTP_FROM="Nexus <no-reply@example.com>"

# ── Storage / S3 (Phase 7) ───────────────────────────────────────────────────
# For local dev, MinIO runs at localhost:9000 via docker-compose
# AWS_ACCESS_KEY_ID=minio                    # MinIO default
# AWS_SECRET_ACCESS_KEY=minio123             # MinIO default
# AWS_REGION=us-east-1
# AWS_BUCKET_NAME=nexus-uploads
# AWS_ENDPOINT=http://localhost:9000         # Remove for real AWS S3

# ── ClamAV (Phase 7) ─────────────────────────────────────────────────────────
# Set CLAMAV_ENABLED=false to skip virus scanning in local dev (no Docker)
# CLAMAV_HOST=localhost
# CLAMAV_PORT=3310
# CLAMAV_ENABLED=true

# ── Dead-letter Alerts (Phase 4) ─────────────────────────────────────────────
# POST payload sent when a BullMQ job hits its final failure
# ALERTS_WEBHOOK_URL=        # Slack/Teams/Discord webhook URL
