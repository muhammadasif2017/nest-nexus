{
  "info": {
    "name": "nest-nexus API",
    "description": "REST endpoints for the nest-nexus NestJS boilerplate. JWT auth, session auth, OAuth, 2FA, magic links, uploads, health, metrics.\n\nSet `baseUrl` (REST, e.g. http://localhost:3000/api/v1) and `metricsUrl` (e.g. http://localhost:3000/metrics) collection variables before running.\n\nLogin requests auto-capture `accessToken` into a collection variable via a test script — protected requests use {{accessToken}} as a Bearer token.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000/api/v1"
    },
    {
      "key": "metricsUrl",
      "value": "http://localhost:3000/metrics"
    },
    {
      "key": "accessToken",
      "value": ""
    },
    {
      "key": "deviceId",
      "value": ""
    },
    {
      "key": "userId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Auth (JWT)",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"test.user@example.com\",\n  \"displayName\": \"Test User\",\n  \"password\": \"Str0ng!Passw0rd\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "register"
              ]
            }
          }
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const body = pm.response.json();",
                  "  if (body.accessToken) pm.collectionVariables.set('accessToken', body.accessToken);",
                  "  if (body.user && body.user.id) pm.collectionVariables.set('userId', body.user.id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"test.user@example.com\",\n  \"password\": \"Str0ng!Passw0rd\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            }
          }
        },
        {
          "name": "Refresh",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": ""
            },
            "url": {
              "raw": "{{baseUrl}}/auth/refresh",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "refresh"
              ]
            },
            "description": "Relies on the HttpOnly refresh_token cookie set during login. Enable Postman's cookie jar for this domain."
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/logout",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "logout"
              ]
            }
          }
        },
        {
          "name": "Me",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "me"
              ]
            }
          }
        },
        {
          "name": "List device sessions",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/sessions",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "sessions"
              ]
            }
          }
        },
        {
          "name": "Revoke device session",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/sessions/{{deviceId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "sessions",
                "{{deviceId}}"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "OAuth",
      "item": [
        {
          "name": "Google — start flow (browser only)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/auth/google",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "google"
              ]
            },
            "description": "Redirects to Google. Cannot be exercised meaningfully from Postman — open in a browser."
          }
        },
        {
          "name": "Google — callback (browser only)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/auth/google/callback",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "google",
                "callback"
              ]
            },
            "description": "Hit by Google's redirect, not called directly. Issues JWT + HttpOnly cookie, redirects to client origin with token in URL fragment."
          }
        },
        {
          "name": "GitHub — start flow (browser only)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/auth/github",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "github"
              ]
            }
          }
        },
        {
          "name": "GitHub — callback (browser only)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/auth/github/callback",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "github",
                "callback"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Two-Factor Auth",
      "item": [
        {
          "name": "Setup",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/2fa/setup",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "2fa",
                "setup"
              ]
            },
            "description": "Returns { secret, otpauthUrl, qrCodeDataUrl }. Scan otpauthUrl/qrCodeDataUrl with an authenticator app, then call Enable with the resulting code."
          }
        },
        {
          "name": "Enable",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"code\": \"123456\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/2fa/enable",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "2fa",
                "enable"
              ]
            },
            "description": "Returns 10 single-use backup codes — save them, shown only once."
          }
        },
        {
          "name": "Disable",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"code\": \"123456\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/2fa/disable",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "2fa",
                "disable"
              ]
            }
          }
        },
        {
          "name": "Verify (pending-2FA exchange)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"code\": \"123456\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/2fa/verify",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "2fa",
                "verify"
              ]
            },
            "description": "Authorization header must carry the short-lived two_factor_pending token returned by Login, not a normal access token."
          }
        }
      ]
    },
    {
      "name": "Magic Link",
      "item": [
        {
          "name": "Send",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"test.user@example.com\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/magic-link/send",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "magic-link",
                "send"
              ]
            },
            "description": "Always returns 200 regardless of whether the email exists. Check the worker/email log (SMTP stubbed) for the link in dev."
          }
        },
        {
          "name": "Verify",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const body = pm.response.json();",
                  "  if (body.accessToken) pm.collectionVariables.set('accessToken', body.accessToken);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/auth/magic-link/verify?token=PASTE_TOKEN_HERE",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "magic-link",
                "verify"
              ],
              "query": [
                {
                  "key": "token",
                  "value": "PASTE_TOKEN_HERE"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Session Auth",
      "item": [
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-CSRF-Token",
                "value": "{{csrfToken}}",
                "description": "Double-submit cookie pattern — read the XSRF-TOKEN cookie value and mirror it here."
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"test.user@example.com\",\n  \"password\": \"Str0ng!Passw0rd\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/session/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "session",
                "login"
              ]
            },
            "description": "Sets HttpOnly session cookie. Returns 401 with errorCode TWO_FACTOR_REQUIRED if 2FA is enabled — use the JWT flow instead for those accounts."
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-CSRF-Token",
                "value": "{{csrfToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/session/logout",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "session",
                "logout"
              ]
            },
            "description": "Requires an active session cookie (SessionGuard) — not @Public()."
          }
        }
      ]
    },
    {
      "name": "Uploads",
      "item": [
        {
          "name": "Upload avatar",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "src": []
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/upload/avatar",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "upload",
                "avatar"
              ]
            },
            "description": "Scanned via ClamAV, resized to 256x256 WebP, uploaded to S3."
          }
        },
        {
          "name": "Upload file",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "src": []
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/upload/file",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "upload",
                "file"
              ]
            },
            "description": "Max 20MB, stored as-is after virus scan."
          }
        },
        {
          "name": "Delete uploaded file",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/upload/avatars/{{userId}}/PASTE_FILENAME.webp",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "upload",
                "avatars",
                "{{userId}}",
                "PASTE_FILENAME.webp"
              ]
            },
            "description": "Key must be prefixed with avatars/{userId}/ or uploads/{userId}/ to pass the ownership check."
          }
        }
      ]
    },
    {
      "name": "Health",
      "item": [
        {
          "name": "Liveness",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/health/live",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "health",
                "live"
              ]
            }
          }
        },
        {
          "name": "Readiness",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/health/ready",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "health",
                "ready"
              ]
            }
          }
        },
        {
          "name": "Deep",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/health/deep",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "health",
                "deep"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Metrics",
      "item": [
        {
          "name": "Prometheus metrics",
          "request": {
            "method": "GET",
            "url": "{{metricsUrl}}",
            "description": "Excluded from the /api/v1 prefix — scraped bare at /metrics."
          }
        }
      ]
    },
    {
      "name": "Users",
      "item": [
        {
          "name": "me (own profile)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": "{{baseUrl}}/users/me"
          }
        },
        {
          "name": "user (by id)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": "{{baseUrl}}/users/{{userId}}",
            "description": "Authenticated — requires a valid JWT."
          }
        },
        {
          "name": "users (admin only)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": "{{baseUrl}}/users",
            "description": "Requires ADMIN or SUPER_ADMIN role."
          }
        },
        {
          "name": "updateProfile",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"displayName\": \"Updated Name\"\n}"
            },
            "url": "{{baseUrl}}/users/me"
          }
        },
        {
          "name": "deactivateUser (admin only)",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": "{{baseUrl}}/users/{{userId}}",
            "description": "Requires ADMIN or SUPER_ADMIN role. Soft delete (sets isActive=false). Emits user.deactivated — JwtStrategy/SessionGuard caches invalidate within ~30s, see ADR-013."
          }
        }
      ]
    }
  ]
}
