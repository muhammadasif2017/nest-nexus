{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "transform": {
    "^.+\\.(t|j)s$": ["ts-jest", { "tsconfig": "./tsconfig.spec.json", "diagnostics": false }]
  },
  "transformIgnorePatterns": ["node_modules/(?!(?:@otplib|otplib|@scure|@noble)/)"],
  "maxWorkers": 1,
  "testTimeout": 30000
}
